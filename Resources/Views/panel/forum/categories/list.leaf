#extend("main"):
#export("body"):

<h2>Forum categories</h2>

<div class="infobox">There are <strong>#(metadata.total) forum categories</strong> in database.</div>

<a href="/panel/forum/categories/new" class="create">Create a new forum category</a>

<table class="items">
  <tr>
    <th>Name</th>
    <th>Details</th>
    <th>Posts count</th>
    <th>Delete</th>
  </tr>
#for(category in items):
  <tr>
    <td><a href="/panel/forum/categories/#(category.id)">#(category.name)</a></td>
    <td>#(category.details)</td>
    <td>#count(category.forumPosts)</td>
    <td>
      <form method="POST" action="/panel/forum/categories/#(category.id)/delete" onsubmit="return confirm('Delete this category?');">
        <button class="delete" type="submit">X</button>
      </form>
    </td>
  </tr>
#endfor
</table>

#extend("components/pagination")

#endexport
#endextend
