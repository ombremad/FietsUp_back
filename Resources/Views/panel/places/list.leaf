#extend("main"):
#export("body"):

<h2>Places</h2>

<div class="infobox">There are <strong>#(metadata.total) places</strong> in database.</div>

<a href="/panel/places/new" class="create">Create a new place</a>

<table class="items">
  <tr>
    <th>Name</th>
    <th>Categories</th>
    <th>Address</th>
    <th>City</th>
    <th>Country</th>
    <th>Delete</th>
  </tr>
#for(place in items):
  <tr>
    <td><a href="/panel/places/#(place.id)">#(place.name)</a></td>
    <td>
      #for(category in place.categories):
        #(category.name)#if(!isLast):, #endif
      #endfor
    </td>
    <td>#(place.address)</td>
    <td>#(place.city)</td>
    <td>#(place.country)</td>
    <td>
      <form method="POST" action="/panel/places/#(place.id)/delete" onsubmit="return confirm('Delete this place?');">
        <button class="delete" type="submit">X</button>
      </form>
    </td>
  </tr>
#endfor
</table>

#extend("components/pagination")

#endexport
#endextend
