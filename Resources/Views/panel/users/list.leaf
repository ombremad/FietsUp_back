#extend("main"):
#export("body"):

<h2>Users</h2>

<div class="infobox">There are <strong>#(metadata.total) users</strong> in database.</div>

<table class="items">
  <tr>
    <th>Email</th>
    <th>Nickname</th>
    <th>First name</th>
    <th>Last name</th>
    <th>Admin rights</th>
  </tr>
  #for(user in items):
  <tr>
    <td><a href="/panel/users/#(user.id)">#(user.email)</a></td>
    <td>#(user.nickname)</td>
    <td>#(user.firstName)</td>
    <td>#(user.lastName)</td>
    <td>#(user.adminRights)</td>
  </tr>
  #endfor
</table>

#extend("components/pagination")

#endexport
#endextend
